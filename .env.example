# Copy to .env and fill in. .env is gitignored — never commit real values.
DISCORD_TOKEN=your-bot-token
CHANNEL_ID=your-channel-id
# Optional (defaults shown):
MC_HOST=127.0.0.1
MC_PORT=25565
POLL_INTERVAL=30
# Optional: your server's guild ID for instant slash-command sync
GUILD_ID=
# Shown in /status (optional):
SERVER_IP=your-tunnel.example.tun.ply.gg
MODPACK_URL=
# Two-way chat bridge (optional). Needs the Message Content privileged intent
# enabled in the Discord Developer Portal, and RCON enabled on the server.
LOG_PATH=C:\path\to\server\logs\latest.log
RCON_PORT=25575
RCON_PASSWORD=your-rcon-password
# /startserver: anyone can request a start; the owner approves via DM.
OWNER_ID=your-discord-user-id
DASHBOARD_URL=http://127.0.0.1:8765
# Live status page (optional): served on this port only while the MC server is up.
# Expose it (e.g. a second playit.gg tunnel) and put its public URL in STATUS_URL
# so the Discord embed links to it.
WEB_PORT=
STATUS_URL=
